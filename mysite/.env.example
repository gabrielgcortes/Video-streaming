# Django
DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=flixy.ddns.net,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://flixy.ddns.net
DJANGO_LANGUAGE_CODE=es-mx
DJANGO_TIME_ZONE=America/Mexico_City

# PostgreSQL
DB_NAME=flixy
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# AWS / S3
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_STORAGE_BUCKET_NAME=replace-with-bucket-name
AWS_S3_REGION_NAME=us-east-2

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-email
EMAIL_HOST_PASSWORD=replace-with-email-password
